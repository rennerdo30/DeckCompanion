[Desktop Entry]
Type=Application
Name=Install DeckCompanion
Comment=Install DeckCompanion in your home directory and restart Steam
Terminal=false
Icon=system-software-install
Exec=konsole --hold -e bash -o pipefail -c "curl -fsSL --proto =https --proto-redir =https --connect-timeout 10 --max-time 30 https://github.com/rennerdo30/DeckCompanion/releases/latest/download/install.sh | timeout 300s sh"
Categories=Utility;
