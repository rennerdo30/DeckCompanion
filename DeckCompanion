#!/usr/bin/env python3
"""Migration entry for old git-clone tools; this launcher never runs git pull."""
import os
from pathlib import Path
import re
import sys


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    share = Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share")))
    raw = os.environ.get("DECKCOMPANION_HOME", str(share / "deckcompanion"))
    if not raw.strip():
        raise SystemExit("DECKCOMPANION_HOME must not be empty")
    home = Path(raw).expanduser()
    pointer = home / "current"
    version = pointer.read_text(encoding="utf-8").strip() if pointer.exists() else ""
    engine = home / "versions" / version
    if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", version) and (engine / "src/deckcompanion/__main__.py").is_file():
        roots = [str(engine / "src"), str(engine)]
        sys.path[:0] = roots
        os.environ["PYTHONPATH"] = os.pathsep.join(roots)
        from deckcompanion.cli import main as cli
        return cli(["launch", *argv])
    sys.path[:0] = [str(Path(__file__).resolve().parent / "src"), str(Path(__file__).resolve().parent)]
    from deckcompanion.common import Paths, atomic, now
    from deckcompanion.steam import proton
    paths = Paths.env()
    ident = os.environ.get("SteamAppId") or os.environ.get("SteamGameId", "unknown")
    if not ident.isdigit():
        ident = "unknown"
    atomic(paths.data / "logs" / f"{ident}-last.log", f"{now()} Legacy install: run the new install.sh with Steam closed. Falling back to installed Proton; no fixes applied.\n")
    installed = proton(paths)
    if not installed or len(argv) < 2:
        raise SystemExit("Install GE-Proton/Valve Proton and run the new DeckCompanion installer")
    executable = str(Path(installed[0]["path"]) / "proton")
    os.execve(executable, [executable, *argv], dict(os.environ))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
